{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "portfolio",
  "type": "registry:block",
  "title": "Portfolio Starter",
  "description": "A portfolio application with asset tracking and transaction history",
  "registryDependencies": [
    "theme"
  ],
  "files": [
    {
      "path": "src/app/starters/(minimal)/portfolio/page.tsx",
      "content": "\"use client\";\n\nimport { ArrowDown, ArrowUp, Info } from \"lucide-react\";\nimport React from \"react\";\n\nimport { Badge } from \"@/components/ui/badge\";\nimport { Button } from \"@/components/ui/button\";\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\";\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \"@/components/ui/tabs\";\nimport {\n  Tooltip,\n  TooltipContent,\n  TooltipProvider,\n  TooltipTrigger,\n} from \"@/components/ui/tooltip\";\nimport { cn } from \"@/lib/utils\";\n\n// Mock portfolio data\nconst PORTFOLIO_DATA = {\n  totalValue: 2347.89,\n  percentChange: 5.67,\n  isPositiveChange: true,\n  assets: [\n    {\n      name: \"SOL\",\n      fullName: \"Solana\",\n      amount: 12.5,\n      value: 1250.0,\n      percentOfPortfolio: 53.24,\n      percentChange24h: 8.32,\n      isPositive: true,\n    },\n    {\n      name: \"USDC\",\n      fullName: \"USD Coin\",\n      amount: 750.35,\n      value: 750.35,\n      percentOfPortfolio: 31.96,\n      percentChange24h: 0.01,\n      isPositive: true,\n    },\n    {\n      name: \"BONK\",\n      fullName: \"Bonk\",\n      amount: 2500000,\n      value: 225.0,\n      percentOfPortfolio: 9.58,\n      percentChange24h: 12.75,\n      isPositive: true,\n    },\n    {\n      name: \"JTO\",\n      fullName: \"Jito\",\n      amount: 8.14,\n      value: 122.54,\n      percentOfPortfolio: 5.22,\n      percentChange24h: -2.45,\n      isPositive: false,\n    },\n  ],\n  transactions: [\n    {\n      id: \"tx1\",\n      type: \"buy\",\n      asset: \"SOL\",\n      amount: 2.5,\n      value: 250.0,\n      date: new Date(Date.now() - 2 * 24 * 60 * 60 * 1000),\n      status: \"completed\",\n    },\n    {\n      id: \"tx2\",\n      type: \"sell\",\n      asset: \"BONK\",\n      amount: 500000,\n      value: 45.0,\n      date: new Date(Date.now() - 5 * 24 * 60 * 60 * 1000),\n      status: \"completed\",\n    },\n    {\n      id: \"tx3\",\n      type: \"buy\",\n      asset: \"JTO\",\n      amount: 3.2,\n      value: 48.0,\n      date: new Date(Date.now() - 7 * 24 * 60 * 60 * 1000),\n      status: \"completed\",\n    },\n  ],\n};\n\nfunction PortfolioContent() {\n  const [activeTab, setActiveTab] = React.useState(\"overview\");\n\n  return (\n    <Card className=\"bg-background/80 backdrop-blur-sm border border-[#9945FF]/20 shadow-xl w-full max-w-4xl mx-auto\">\n      <CardHeader className=\"pb-4\">\n        <div className=\"flex items-center justify-between\">\n          <div>\n            <CardTitle className=\"text-xl text-text\">\n              Solana Portfolio\n            </CardTitle>\n            <CardDescription className=\"text-text/70\">\n              Track and manage your assets\n            </CardDescription>\n          </div>\n          <div className=\"flex items-center gap-4\">\n            <div className=\"text-right\">\n              <p className=\"text-sm text-text/70\">Total Value</p>\n              <div className=\"flex items-center gap-2\">\n                <p className=\"text-xl font-bold text-text\">\n                  ${PORTFOLIO_DATA.totalValue.toFixed(2)}\n                </p>\n                <Badge\n                  variant=\"outline\"\n                  className={cn(\n                    \"flex items-center gap-1\",\n                    PORTFOLIO_DATA.isPositiveChange\n                      ? \"text-[#14F195] border-[#14F195]/30\"\n                      : \"text-red-500 border-red-500/30\",\n                  )}\n                >\n                  {PORTFOLIO_DATA.isPositiveChange ? (\n                    <ArrowUp className=\"h-3 w-3\" />\n                  ) : (\n                    <ArrowDown className=\"h-3 w-3\" />\n                  )}\n                  {PORTFOLIO_DATA.percentChange}%\n                </Badge>\n              </div>\n            </div>\n          </div>\n        </div>\n      </CardHeader>\n\n      <div className=\"px-6\">\n        <Tabs value={activeTab} onValueChange={setActiveTab} className=\"w-full\">\n          <TabsList className=\"bg-background/50 border border-[#9945FF]/20 p-1\">\n            <TabsTrigger\n              value=\"overview\"\n              className=\"data-[state=active]:bg-[#9945FF] data-[state=active]:text-text\"\n            >\n              Overview\n            </TabsTrigger>\n            <TabsTrigger\n              value=\"assets\"\n              className=\"data-[state=active]:bg-[#9945FF] data-[state=active]:text-text\"\n            >\n              Assets\n            </TabsTrigger>\n            <TabsTrigger\n              value=\"history\"\n              className=\"data-[state=active]:bg-[#9945FF] data-[state=active]:text-text\"\n            >\n              History\n            </TabsTrigger>\n          </TabsList>\n\n          <TabsContent value=\"overview\" className=\"mt-4 space-y-4\">\n            <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-4\">\n              <div className=\"lg:col-span-2\">\n                <Card className=\"border border-[#9945FF]/20 bg-background/50\">\n                  <CardHeader className=\"pb-2\">\n                    <CardTitle className=\"text-md\">\n                      Portfolio Performance\n                    </CardTitle>\n                  </CardHeader>\n                  <CardContent className=\"h-[300px] flex items-center justify-center\">\n                    <div className=\"text-text/50 text-center\">\n                      <p>Portfolio chart visualization</p>\n                      <p className=\"text-sm mt-2\">\n                        Visual representation of portfolio value over time\n                      </p>\n                    </div>\n                  </CardContent>\n                </Card>\n              </div>\n\n              <div>\n                <Card className=\"border border-[#9945FF]/20 bg-background/50\">\n                  <CardHeader className=\"pb-2\">\n                    <CardTitle className=\"text-md\">Asset Allocation</CardTitle>\n                  </CardHeader>\n                  <CardContent>\n                    <div className=\"space-y-2\">\n                      {PORTFOLIO_DATA.assets.map((asset) => (\n                        <div\n                          key={asset.name}\n                          className=\"flex items-center justify-between\"\n                        >\n                          <div className=\"flex items-center gap-2\">\n                            <div className=\"w-8 h-8 rounded-full bg-[#9945FF]/20 flex items-center justify-center text-xs font-bold\">\n                              {asset.name}\n                            </div>\n                            <div>\n                              <p className=\"text-sm font-medium\">\n                                {asset.fullName}\n                              </p>\n                              <p className=\"text-xs text-text/70\">\n                                {asset.percentOfPortfolio.toFixed(1)}%\n                              </p>\n                            </div>\n                          </div>\n                          <div className=\"text-right\">\n                            <p className=\"text-sm font-medium\">\n                              ${asset.value.toFixed(2)}\n                            </p>\n                            <div\n                              className={cn(\n                                \"text-xs\",\n                                asset.isPositive\n                                  ? \"text-[#14F195]\"\n                                  : \"text-red-500\",\n                              )}\n                            >\n                              {asset.isPositive ? \"+\" : \"\"}\n                              {asset.percentChange24h}%\n                            </div>\n                          </div>\n                        </div>\n                      ))}\n                    </div>\n                  </CardContent>\n                </Card>\n              </div>\n            </div>\n\n            <Card className=\"border border-[#9945FF]/20 bg-background/50\">\n              <CardHeader className=\"pb-2\">\n                <CardTitle className=\"text-md\">Recent Transactions</CardTitle>\n              </CardHeader>\n              <CardContent>\n                <div className=\"space-y-3\">\n                  {PORTFOLIO_DATA.transactions.map((tx) => (\n                    <div\n                      key={tx.id}\n                      className=\"flex items-center justify-between p-3 bg-[#9945FF]/5 border border-[#9945FF]/20 rounded-md\"\n                    >\n                      <div className=\"flex items-center space-x-3\">\n                        <div\n                          className={cn(\n                            \"w-8 h-8 rounded-full flex items-center justify-center\",\n                            tx.type === \"buy\"\n                              ? \"bg-[#14F195]/20 text-[#14F195]\"\n                              : \"bg-red-500/20 text-red-500\",\n                          )}\n                        >\n                          {tx.type === \"buy\" ? (\n                            <ArrowDown className=\"h-4 w-4\" />\n                          ) : (\n                            <ArrowUp className=\"h-4 w-4\" />\n                          )}\n                        </div>\n                        <div>\n                          <div className=\"text-sm font-medium\">\n                            {tx.type === \"buy\" ? \"Bought\" : \"Sold\"} {tx.amount}{\" \"}\n                            {tx.asset}\n                          </div>\n                          <div className=\"text-xs text-text/70\">\n                            ${tx.value.toFixed(2)}\n                          </div>\n                        </div>\n                      </div>\n                      <div className=\"text-right\">\n                        <div className=\"text-xs font-medium\">\n                          {tx.status.charAt(0).toUpperCase() +\n                            tx.status.slice(1)}\n                        </div>\n                        <div className=\"text-xs text-text/70\">\n                          {tx.date.toLocaleDateString()}\n                        </div>\n                      </div>\n                    </div>\n                  ))}\n                </div>\n              </CardContent>\n            </Card>\n          </TabsContent>\n\n          <TabsContent value=\"assets\" className=\"mt-4 space-y-4\">\n            {PORTFOLIO_DATA.assets.map((asset) => (\n              <Card\n                key={asset.name}\n                className=\"border border-[#9945FF]/20 bg-background/50\"\n              >\n                <CardHeader className=\"pb-2\">\n                  <div className=\"flex items-center justify-between\">\n                    <div className=\"flex items-center gap-2\">\n                      <div className=\"w-10 h-10 rounded-full bg-[#9945FF]/20 flex items-center justify-center text-sm font-bold\">\n                        {asset.name}\n                      </div>\n                      <div>\n                        <CardTitle className=\"text-md\">\n                          {asset.fullName}\n                        </CardTitle>\n                        <CardDescription>\n                          {asset.amount} {asset.name}\n                        </CardDescription>\n                      </div>\n                    </div>\n                    <div className=\"text-right\">\n                      <p className=\"text-md font-bold\">\n                        ${asset.value.toFixed(2)}\n                      </p>\n                      <Badge\n                        variant=\"outline\"\n                        className={cn(\n                          \"flex items-center gap-1\",\n                          asset.isPositive\n                            ? \"text-[#14F195] border-[#14F195]/30\"\n                            : \"text-red-500 border-red-500/30\",\n                        )}\n                      >\n                        {asset.isPositive ? (\n                          <ArrowUp className=\"h-3 w-3\" />\n                        ) : (\n                          <ArrowDown className=\"h-3 w-3\" />\n                        )}\n                        {asset.percentChange24h}%\n                      </Badge>\n                    </div>\n                  </div>\n                </CardHeader>\n                <CardContent className=\"h-[100px] flex items-center justify-center\">\n                  <div className=\"text-text/50 text-center\">\n                    <p>Asset price chart</p>\n                    <p className=\"text-sm mt-2\">\n                      Visual representation of asset price over time\n                    </p>\n                  </div>\n                </CardContent>\n                <div className=\"px-6 pb-4 flex justify-between\">\n                  <Button\n                    variant=\"outline\"\n                    className=\"border-[#9945FF]/30 hover:border-[#9945FF] hover:bg-[#9945FF]/10\"\n                  >\n                    Buy\n                  </Button>\n                  <Button\n                    variant=\"outline\"\n                    className=\"border-[#9945FF]/30 hover:border-[#9945FF] hover:bg-[#9945FF]/10\"\n                  >\n                    Sell\n                  </Button>\n                </div>\n              </Card>\n            ))}\n          </TabsContent>\n\n          <TabsContent value=\"history\" className=\"mt-4\">\n            <Card className=\"border border-[#9945FF]/20 bg-background/50\">\n              <CardHeader className=\"pb-2\">\n                <CardTitle className=\"text-md\">Transaction History</CardTitle>\n              </CardHeader>\n              <CardContent>\n                <div className=\"space-y-3\">\n                  {PORTFOLIO_DATA.transactions.length > 0 ? (\n                    PORTFOLIO_DATA.transactions.map((tx) => (\n                      <div\n                        key={tx.id}\n                        className=\"flex items-center justify-between p-3 bg-[#9945FF]/5 border border-[#9945FF]/20 rounded-md\"\n                      >\n                        <div className=\"flex items-center space-x-3\">\n                          <div\n                            className={cn(\n                              \"w-8 h-8 rounded-full flex items-center justify-center\",\n                              tx.type === \"buy\"\n                                ? \"bg-[#14F195]/20 text-[#14F195]\"\n                                : \"bg-red-500/20 text-red-500\",\n                            )}\n                          >\n                            {tx.type === \"buy\" ? (\n                              <ArrowDown className=\"h-4 w-4\" />\n                            ) : (\n                              <ArrowUp className=\"h-4 w-4\" />\n                            )}\n                          </div>\n                          <div>\n                            <div className=\"text-sm font-medium\">\n                              {tx.type === \"buy\" ? \"Bought\" : \"Sold\"}{\" \"}\n                              {tx.amount} {tx.asset}\n                            </div>\n                            <div className=\"text-xs text-text/70\">\n                              ${tx.value.toFixed(2)}\n                            </div>\n                          </div>\n                        </div>\n                        <div className=\"text-right\">\n                          <div className=\"text-xs font-medium\">\n                            {tx.status.charAt(0).toUpperCase() +\n                              tx.status.slice(1)}\n                          </div>\n                          <div className=\"text-xs text-text/70\">\n                            {tx.date.toLocaleDateString()}\n                          </div>\n                        </div>\n                      </div>\n                    ))\n                  ) : (\n                    <div className=\"text-center py-8 text-text/50\">\n                      <p>No transaction history</p>\n                    </div>\n                  )}\n                </div>\n              </CardContent>\n            </Card>\n          </TabsContent>\n        </Tabs>\n      </div>\n\n      <CardContent className=\"pt-0 pb-4\">\n        <div className=\"flex items-center justify-between text-xs text-text/50 mt-4 pt-4 border-t border-[#9945FF]/20\">\n          <div>Last updated: {new Date().toLocaleString()}</div>\n          <TooltipProvider>\n            <Tooltip>\n              <TooltipTrigger>\n                <Info className=\"h-3 w-3\" />\n              </TooltipTrigger>\n              <TooltipContent className=\"bg-background border border-[#9945FF]/20 p-2 shadow-md\">\n                <p className=\"text-xs\">\n                  Mock portfolio data for demonstration purposes\n                </p>\n              </TooltipContent>\n            </Tooltip>\n          </TooltipProvider>\n        </div>\n      </CardContent>\n    </Card>\n  );\n}\n\nexport default function PortfolioPage() {\n  return (\n    <div className=\"container py-4\">\n      <PortfolioContent />\n    </div>\n  );\n}\n",
      "type": "registry:file",
      "target": "app/starters/(minimal)/portfolio/page.tsx"
    }
  ]
}